# Copy this file to .env and fill in your keys:
#   cp .env.example .env

# Required — runs ORA's agent loop (chat, reasoning, every tool call).
# Get a free key: https://aistudio.google.com/api-keys
GOOGLE_GENERATIVE_AI_API_KEY=

# Required for the RAG / lending-policy search tool (embeddings + reranking).
# Sign up: https://www.voyageai.com
# Can't create an account? Ask the session organizer for a shared key.
VOYAGE_API_KEY=

# Not used by default — ORA runs on Gemini. Lets the agent's model in
# lib/ora/agent.ts be swapped to Claude live on stage.
# Get a key: https://console.anthropic.com
ANTHROPIC_API_KEY=
