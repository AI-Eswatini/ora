# Copy this file to .env and fill in your keys:
#   cp .env.example .env

# Required — runs ORA's agent loop (chat, reasoning, every tool call).
# Get a free key: https://aistudio.google.com/api-keys
GOOGLE_GENERATIVE_AI_API_KEY=

# Required for the RAG / lending-policy search tool (embeddings + reranking).
# The key below is a temporary test key for this session and may stop working
# at any time. For anything beyond the session, sign up for your own:
# https://www.voyageai.com
VOYAGE_API_KEY=pa-IqRJ-zezTkULiBjDoucToA-3mnDEuLBt4df1r1NVq5c

# Not used by default — ORA runs on Gemini. Lets the agent's model in
# lib/ora/agent.ts be swapped to Claude live on stage.
# Get a key: https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional — enables the notifyLoanDecision tool, which posts recorded
# decisions to Slack. If unset, the tool isn't offered to the agent at all.
# Create a Slack app with the chat:write scope, install it to your
# workspace, and invite the bot to the target channel.
SLACK_BOT_TOKEN=

# Optional — Slack channel notifyLoanDecision posts to. Defaults to
# "loan-approvals" if unset. Only used when SLACK_BOT_TOKEN is set.
SLACK_LOAN_APPROVALS_CHANNEL=
